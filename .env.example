# AKAIROS thresholds
WATCH_30=30
OVERTIME_40=40
CRITICAL_50=50
AMAZON_WEEKLY_MAX=60
DAILY_MAX=12
MIN_REST_HOURS=10
LEAD_HOURS=2

# Live data connectors: disabled | file | http
# Required source columns: employee_id,name,date,hours
PAYROLL_CONNECTOR_TYPE=disabled
PAYROLL_FILE_PATH=
PAYROLL_API_URL=
PAYROLL_API_TOKEN_ENV=PAYROLL_API_TOKEN

DSP_SCHEDULE_CONNECTOR_TYPE=disabled
DSP_SCHEDULE_FILE_PATH=
DSP_SCHEDULE_API_URL=
DSP_SCHEDULE_API_TOKEN_ENV=DSP_SCHEDULE_API_TOKEN

# Optional associate/manager roster file
ROSTER_FILE_PATH=

# Amazon Scheduling browser capture (local authenticated session; never commit browser_profile/)
AMAZON_SCHEDULING_URL=

# Automated alert channel: stdout | slack | email | sms
ALERT_CHANNEL=stdout
SEND_MANAGER_ALERTS=true
SEND_ASSOCIATE_ALERTS=false

# Slack
SLACK_WEBHOOK_URL=

# Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_PHONE=

# Email SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL=
